{
  "id": "welearn",
  "name": "WeLearn",
  "version": "0.1.7",
  "author": "CometNetworkStudio",
  "runtime": "python3",
  "entry": "main.py",
  "args": [],
  "requires": [
    "requests"
  ],
  "actions": [
    {
      "id": "time",
      "name": "挂时长",
      "description": "按本次总时长选择所需 SCO 模拟学习并保存",
      "params": [
        {
          "key": "cid",
          "label": "课程 id",
          "type": "text",
          "default": "",
          "help": "留空使用账号下的第一门课程"
        },
        {
          "key": "unit_idx",
          "label": "单元下标(0起，空=全部)",
          "type": "text",
          "default": "",
          "help": "WeLearn 的单元下标从 0 开始"
        },
        {
          "key": "duration",
          "label": "挂时长(秒)",
          "type": "number",
          "default": 60,
          "help": "本次任务的总挂时长，均分到本次处理的 SCO"
        },
        {
          "key": "limit",
          "label": "最多 SCO 数(0=不限)",
          "type": "number",
          "default": 0,
          "help": "本次最多处理多少个 SCO"
        }
      ]
    },
    {
      "id": "progress",
      "name": "提交进度",
      "description": "提交未完成 SCO 的进度，可指定正确率",
      "params": [
        {
          "key": "cid",
          "label": "课程 id",
          "type": "text",
          "default": "",
          "help": "留空使用账号下的第一门课程"
        },
        {
          "key": "unit_idx",
          "label": "单元下标(0起，空=全部)",
          "type": "text",
          "default": "",
          "help": "WeLearn 的单元下标从 0 开始"
        },
        {
          "key": "accuracy",
          "label": "正确率",
          "type": "number",
          "default": 100,
          "help": "提交进度时写入的正确率"
        },
        {
          "key": "include_completed",
          "label": "含已完成 SCO（提交进度）",
          "type": "switch",
          "default": false
        },
        {
          "key": "limit",
          "label": "最多 SCO 数(0=不限)",
          "type": "number",
          "default": 0,
          "help": "本次最多处理多少个 SCO"
        }
      ]
    }
  ],
  "credentials": [
    {
      "key": "username",
      "label": "账号",
      "type": "text"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password"
    }
  ],
  "params": [
    {
      "key": "cid",
      "label": "课程 id",
      "type": "text",
      "default": "",
      "help": "留空使用账号下的第一门课程"
    },
    {
      "key": "unit_idx",
      "label": "单元下标(0起，空=全部)",
      "type": "text",
      "default": "",
      "help": "WeLearn 的单元下标从 0 开始"
    },
    {
      "key": "duration",
      "label": "挂时长(秒)",
      "type": "number",
      "default": 60,
      "help": "本次任务的总挂时长，均分到本次处理的 SCO"
    },
    {
      "key": "accuracy",
      "label": "正确率",
      "type": "number",
      "default": 100,
      "help": "提交进度时写入的正确率"
    },
    {
      "key": "include_completed",
      "label": "含已完成 SCO（提交进度）",
      "type": "switch",
      "default": false
    },
    {
      "key": "limit",
      "label": "最多 SCO 数(0=不限)",
      "type": "number",
      "default": 0,
      "help": "本次最多处理多少个 SCO"
    }
  ],
  "discovery": {
    "label": "课程",
    "primary": "name",
    "columns": [
      {
        "key": "name",
        "label": "课程名",
        "type": "text",
        "important": true
      },
      {
        "key": "cid",
        "label": "课程ID",
        "type": "text",
        "sort": "number"
      },
      {
        "key": "per",
        "label": "进度",
        "type": "progress",
        "important": true,
        "sort": "number"
      },
      {
        "key": "state",
        "label": "状态",
        "type": "chip",
        "important": true
      },
      {
        "key": "study_time",
        "label": "学习时长",
        "type": "text",
        "important": true,
        "sort": "duration"
      },
      {
        "key": "total",
        "label": "练习总数",
        "type": "text",
        "sort": "number"
      },
      {
        "key": "done",
        "label": "已完成",
        "type": "text",
        "sort": "number"
      },
      {
        "key": "remaining",
        "label": "待完成",
        "type": "text",
        "sort": "number"
      },
      {
        "key": "avg_accuracy",
        "label": "平均正确率",
        "type": "text",
        "sort": "percent"
      }
    ],
    "actions": [
      "time",
      "progress"
    ],
    "param_map": {
      "cid": "cid"
    }
  }
}
